{
  "name": "dsh-session-delete",
  "version": "1.1.0",
  "private": true,
  "description": "Delete whole dsh web conversations, or truncate the trailing turns of one conversation (rewrites the JSONL session log).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "session",
    "delete",
    "conversation",
    "plugin"
  ],
  "license": "MIT"
}
