{
  "name": "dsh-xykp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件集合（kilopackages）：预设、记忆、通道、B 站工具与配套小服务。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/xingyuan233/dsh-xykp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./storage/preset-loader": "./storage/preset-loader/index.js",
    "./chat/preset-binder": "./chat/preset-binder/index.js",
    "./chat/preset-binder/table": "./chat/preset-binder/table.js",
    "./chat/toolret-forget": "./chat/toolret-forget/index.js",
    "./chat/toolret-forget/fold": "./chat/toolret-forget/fold.js",
    "./chat/memory-refine": "./chat/memory-refine/lib/index.js",
    "./chat/token-reporter": "./chat/token-reporter/index.js",
    "./senses/screenshot": "./senses/screenshot/index.js",
    "./senses/keymouse": "./senses/keymouse/index.js",
    "./comms/bili-rove": "./comms/bili-rove/lib/index.js",
    "./storage/log-cleaner": "./storage/log-cleaner/lib/index.js",
    "./storage/session-delete": "./storage/session-delete/lib/index.js",
    "./observer/plugin-gate": "./observer/plugin-gate/lib/index.js",
    "./observer/dsh-prosecutor": "./observer/dsh-prosecutor/lib/index.js",
    "./storage/session-delete/client": "./storage/session-delete/lib/client.js",
    "./storage/session-archiver": "./storage/session-archiver/lib/index.js",
    "./comms/bili-reply": "./comms/bili-reply/lib/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "core",
    "storage",
    "chat",
    "senses",
    "comms",
    "plan",
    "observer",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "js-yaml": "4.3.2"
  }
}
